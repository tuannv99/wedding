# Copy file này thành .env.local (không commit .env.local — đã có trong .gitignore)
# rồi điền giá trị thật lấy từ Supabase Dashboard → Project Settings → API.

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (Settings → API → Project API keys → anon public)
# Key này LỘ RA trình duyệt là chuyện bình thường — nó chỉ có đúng quyền mà
# RLS policy trong supabase/schema.sql cho phép (đọc lời chúc đã duyệt, gửi
# lời chúc mới). Không dùng service_role key ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
